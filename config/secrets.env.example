# Kopieer dit bestand naar ~/.config/stamboom/secrets.env en vul het in.
#
#   ./bin/secrets-edit.sh
#
# Dat bestand staat BUITEN de repo (chmod 600) en geldt voor al je
# stamboom-projecten. Het komt nooit in git.

# --- Verplicht -------------------------------------------------------------

# Webtrees API-token (Bearer).
# Aanmaken in webtrees: Mijn account -> API-tokens.
TOKEN=

# --- Optioneel (defaults staan ernaast) ------------------------------------

# WEBTREES_URL=https://www.stamboomwesterman.net
# WEBTREES_TREE=tree1
# TOOLS_DIR=$HOME/.local/share/stamboom-tools
# OCR_MODELS=$HOME/ocr-models
# UPLOAD_ROOTS=/tmp:$HOME/Documents:$HOME/Downloads:$HOME/Pictures

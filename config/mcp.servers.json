{
  "_comment": "ENIGE bron van waarheid voor MCP-servers en de tools die ze nodig hebben. Placeholders: ${TOOLS_DIR} ${HOME} ${WEBTREES_URL} ${WEBTREES_TREE} ${UPLOAD_ROOTS} ${OCR_MODELS} ${GA_DATA_DIR} ${GA_USER_AGENT} ${CHROME_PATH}. ${TOKEN} wordt NIET door de renderer ingevuld maar per client als env-referentie geemit. Let op: _vars worden alleen tegen de env-bestanden geexpand, niet tegen elkaar — zet samengestelde defaults in de server-environment.",
  "_vars": {
    "TOOLS_DIR": "${TOOLS_DIR:-$HOME/.local/share/stamboom-tools}",
    "WEBTREES_URL": "${WEBTREES_URL:-https://www.stamboomwesterman.net}",
    "WEBTREES_TREE": "${WEBTREES_TREE:-tree1}",
    "UPLOAD_ROOTS": "${UPLOAD_ROOTS:-/tmp:${HOME}/Documents:${HOME}/Downloads:${HOME}/Pictures}",
    "OCR_MODELS": "${OCR_MODELS:-${HOME}/ocr-models}",
    "CHROME_PATH": "${CHROME_PATH-}"
  },

  "tools": {
    "webtrees-API": {
      "repo": "git@github.com:harrywesterman/webtrees-API.git",
      "dir": "webtrees-API",
      "ref": "master",
      "update": "pull",
      "build": null,
      "entry": "bin/webtrees-mcp.mjs",
      "note": "Eigen fork van Jefferson49/webtrees-API. bin/webtrees-mcp.mjs gebruikt alleen Node-builtins (geen npm install), maar vereist Node 22+. Integratie bijgewerkt voor master 119809d (2026-10-08): merge-writes, create-records en lokale media-batches."
    },
    "archiefakte-mcp": {
      "repo": "https://github.com/harrywesterman/archiefakte-mcp.git",
      "dir": "archiefakte-mcp",
      "ref": "main",
      "update": "pull",
      "build": "uv sync --frozen",
      "entry": null,
      "note": "Python-MCP (uv). Gelders Archief-registerscans + Open Archieven-zoeken. Draait via `uv run --frozen geldersarchief-mcp`; uv sync --frozen bouwt de venv uit uv.lock."
    },
    "familysearch-mcp": {
      "repo": "git@github.com:harrywesterman/familysearch-mcp.git",
      "dir": "familysearch-mcp",
      "ref": "improvement",
      "update": "pull",
      "build": "npm ci && npm run build",
      "entry": "build/index.js",
      "note": "Eigen fork. De verbeteringen staan op branch 'improvement', niet op 'main'."
    },
    "newspapers-mcp": {
      "repo": "https://github.com/raphink/newspapers-mcp.git",
      "dir": "newspapers-mcp",
      "ref": "769e74bbe726b0116d447e3728c5f30f7d0acb02",
      "update": "pin",
      "build": "npm ci && npm run build",
      "entry": "build/index.js",
      "note": "Upstream, gepind op de geteste commit."
    },
    "nl-gov-mcp": {
      "repo": "https://github.com/WAINUTAI/NL-GOV-MCP.git",
      "dir": "nl-gov-mcp",
      "ref": "8ba92d75b5c9b6221b8c87fff5ecc932f95ef122",
      "update": "pin",
      "build": "npm ci && npm run build",
      "entry": "dist/src/index.js",
      "note": "Upstream, gepind op de geteste commit."
    }
  },

  "extra_installs": {
    "ocr": {
      "kind": "pipx",
      "package": "mcp-ocr",
      "note": "Levert het commando mcp-ocr in ~/.local/bin."
    },
    "kraken": {
      "kind": "python-venv",
      "python": "3.13",
      "venv": "${OCR_MODELS}/.venv-kraken",
      "packages": ["kraken"],
      "note": "Kraken werkt NIET op Python 3.14; gebruik 3.13 via uv."
    },
    "arletta-models": {
      "kind": "remotezip",
      "url": "https://zenodo.org/api/records/11191457",
      "files": ["super.mlmodel", "blla.mlmodel"],
      "dest": "${OCR_MODELS}/ARletta/models",
      "note": "Alleen de ~21 MB modellen ophalen, niet de 8,5 GB zip."
    },
    "playwright-chromium": {
      "kind": "npx",
      "command": "npx playwright install chromium",
      "note": "Nodig voor de Playwright-MCP en voor de FamilySearch browser-login."
    }
  },

  "servers": {
    "webtrees-mcp-server": {
      "type": "local",
      "command": ["node", "${TOOLS_DIR}/webtrees-API/bin/webtrees-mcp.mjs"],
      "environment": {
        "WEBTREES_MCP_URL": "${WEBTREES_URL}/mcp",
        "WEBTREES_UPLOAD_ROOTS": "${UPLOAD_ROOTS}",
        "TOKEN": "${TOKEN}"
      },
      "timeout": 180000,
      "enabled": true
    },
    "familysearch": {
      "type": "local",
      "command": ["node", "${TOOLS_DIR}/familysearch-mcp/build/index.js"],
      "environment": {
        "BRAVE_PATH": "${CHROME_PATH}"
      },
      "enabled": true
    },
    "newspapers": {
      "type": "local",
      "command": ["node", "${TOOLS_DIR}/newspapers-mcp/build/index.js"],
      "enabled": true
    },
    "nl-gov-mcp": {
      "type": "local",
      "command": ["node", "${TOOLS_DIR}/nl-gov-mcp/dist/src/index.js"],
      "enabled": true
    },
    "archiefakte": {
      "type": "local",
      "command": ["uv", "--directory", "${TOOLS_DIR}/archiefakte-mcp", "run", "--frozen", "geldersarchief-mcp"],
      "environment": {
        "GA_DATA_DIR": "${GA_DATA_DIR:-${TOOLS_DIR}/archiefakte-mcp/data}",
        "GA_USER_AGENT": "${GA_USER_AGENT:-${WEBTREES_URL}}"
      },
      "timeout": 180000,
      "enabled": true
    },
    "ocr": {
      "type": "local",
      "command": ["${HOME}/.local/bin/mcp-ocr"],
      "enabled": true
    },
    "openarchieven": {
      "type": "remote",
      "url": "https://mcp.openarchieven.nl/",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true
    }
  }
}
